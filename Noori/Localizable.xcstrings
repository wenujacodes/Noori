    "Discrete transitions snap between Green (0–60%), Yellow (60–85%), and Red (85–100%)." : {
      "comment" : "A description of how the color-coded progress bars work when not using smooth transitions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계적 전환은 초록색(0~60%), 노란색(60~85%), 빨간색(85~100%) 구간에 맞춰 색상이 즉시 전환됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn discrete overgangen tussen groen (0–60%), geel (60–85%) en rood (85–100%)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transições discretas se encaixam entre Verde (0–60%), Amarelo (60–85%) e Vermelho (85–100%)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключено при активной интеграции BetterDisplay — приложение использует Cmd+Клавиши яркости для своего управления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discrete transitions snap between Green (0–60%), Yellow (60–85%), and Red (85–100%)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrık geçişler Yeşil (%0–60), Sarı (%60–85) ve Kırmızı (%85–100) arasında geçiş yapar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离散过渡在绿色（0-60%）、黄色（60-85%）和红色（85-100%）之间切换。"
          }
        }
      }
    },
