          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill. Adjust gradient behavior from Controls › Noori."
          }
        },
        "tr" : {
