          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noori"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noori"
          }
        },
        "tr" : {
