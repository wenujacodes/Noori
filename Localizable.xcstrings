    "Toggle the Noori open or closed from anywhere.": {
      "comment": "A description of the \"Toggle Navigation\" keyboard shortcut.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتبديل Noori مفتوحة أو مغلقة من أي مكان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete nebo zavřete Noori odkudkoli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die dynamische Insel von überall aus öffnen oder schließen."
          }
        },
        "en": {
          "stringUnit": {
