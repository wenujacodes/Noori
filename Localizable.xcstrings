    "Microphone privacy indicator runs automatically whenever apps access audio.": {
      "comment": "A description of the microphone privacy indicator feature.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مؤشر خصوصية الميكروفون تلقائيا كلما وصلت التطبيقات إلى الصوت."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Індзікатар прыватнасці мікрафона ўключаецца аўтаматычна кожны раз, калі праграмы атрымліваюць доступ да гуку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Indikátor soukromí mikrofonu se spouští automaticky vždy, když aplikace přistupují k zvuku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenschutzanzeige des Mikrofons wird automatisch angezeigt, wenn Apps auf Audio zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Microphone privacy indicator runs automatically whenever apps access audio."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone privacy indicator runs automatically whenever apps access audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indicateur de confidentialité du microphone fonctionne automatiquement chaque fois que les applications accèdent à l'audio."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी ऐप्स ऑडियो का उपयोग करती हैं, माइक्रोफ़ोन गोपनीयता संकेतक स्वचालित रूप से चालू हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indicatore di privacy del microfono funziona automaticamente ogni volta che le app accedono all'audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 프라이버시 표시기는 앱이 오디오에 접근할 때마다 자동으로 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonens personvernindikator kjører automatisk når apper får tilgang til lyd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индикатор конфиденциальности микрофона включается автоматически, когда приложения используют аудио."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலிகள் ஒலியை அணுகும் போதெல்லாம் மைக்ரோஃபோன் தனியுரிமை சுட்டிக்காட்டி தானாகவே இயங்கும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon gizlilik göstergesi, uygulamalar sese her eriştiğinde otomatik olarak çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індикатор конфіденційності мікрофона працює автоматично, коли програми отримують доступ до аудіо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风隐私指示器在应用访问音频时自动运行。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวบ่งชี้ความเป็นส่วนตัวไมโครโฟนทำงานอัตโนมัติเมื่อแอปเข้าถึงเสียง"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoonprivacy-indicator wordt automatisch uitgevoerd wanneer apps toegang krijgen tot audio."
          }
        }
      }
    },
