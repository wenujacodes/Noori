    "Shows green camera icon and yellow microphone icon when in use. Uses event-driven CoreAudio and CoreMediaIO APIs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أيقونة الكاميرا الخضراء وأيقونة الميكروفون الصفراء عند الاستخدام. يستخدم واجهات برمجة تطبيقات CoreAudio وCoreMediaIO القائمة على الأحداث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při použití se zobrazí zelená ikona kamery a žlutá ikona mikrofonu. Používá událostmi řízené rozhraní API CoreAudio a CoreMediaIO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt bei Verwendung das grüne Kamerasymbol und das gelbe Mikrofonsymbol an. Verwendet ereignisgesteuerte CoreAudio- und CoreMediaIO-APIs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows green camera icon and yellow microphone icon when in use. Uses event-driven CoreAudio and CoreMediaIO APIs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l'icône de la caméra verte et l'icône jaune du microphone lorsqu'il est utilisé. Utilise les API CoreAudio et CoreMediaIO pilotées par les événements."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપયોગમાં હોય ત્યારે લીલું કેમેરા ચિહ્ન અને પીળું માઇક્રોફોન ચિહ્ન બતાવે છે. ઇવેન્ટ-ચલિત CoreAudio અને CoreMediaIO API નો ઉપયોગ કરે છે."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'icona della fotocamera verde e l'icona gialla del microfono quando è in uso. Utilizza le API CoreAudio e CoreMediaIO basate sugli eventi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser et grønt kameraikon og et gult mikrofonikon når det er i bruk. Bruker hendelsesdrevne CoreAudio- og CoreMediaIO-API-er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает зеленую иконку камеры и желтую иконку микрофона во время их использования."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்பாட்டில் இருக்கும்போது பச்சை கேமரா சின்னத்தையும் மஞ்சள் மைக்ரோஃபோன் சின்னத்தையும் காட்டுகிறது. நிகழ்வு-இயக்கப்படும் கோர்ஆடியோ மற்றும் கோர்மீடியாஐஓ ஏபிஐ-களைப் பயன்படுத்துகிறது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımdayken yeşil kamera simgesi ve sarı mikrofon simgesi gösterir. Olay odaklı CoreAudio ve CoreMediaIO API'lerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час використання відображає зелену піктограму камери та жовту піктограму мікрофона. Використовує API CoreAudio та CoreMediaIO, що керуються подіями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用时显示绿色相机图标和黄色麦克风图标。使用事件驱动的 CoreAudio 和 CoreMediaIO API。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงไอคอนกล้องสีเขียวและไอคอนไมโครโฟนสีเหลืองเมื่อใช้งาน ใช้ CoreAudio และ CoreMediaIO APIs แบบ event-driven"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een groen camerapictogram en een geel microfoonpictogram wanneer deze in gebruik is. Maakt gebruik van gebeurtenisgestuurde CoreAudio- en CoreMediaIO-API's."
          }
        }
      }
    },
