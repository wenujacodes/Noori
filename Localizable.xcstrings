    "Select the music source you want to use. You can change this later in the app settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مصدر الموسيقى الذي تريد استخدامه. يمكنك تغيير هذا لاحقا في إعدادات التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte zdroj hudby, který chcete použít. Toto nastavení můžete později změnit v nastavení aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Musik Quelle aus, die du benutzen willst. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz müzik kaynağını seçin. Bunu daha sonra uygulama ayarlarından değiştirebilirsiniz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la source de musique que vous souhaitez utiliser. Vous pourrez la modifier plus tard dans les paramètres de l'application."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઉપયોગ કરવા માંગતા સંગીત સ્ત્રોત પસંદ કરો. તમે તેને પછી એપની સેટિંગ્સમાં બદલી શકો છો."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selezionare la sorgente musicale che si desidera utilizzare. È possibile modificare questa impostazione in seguito nelle impostazioni dell'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음악 소스 선택하세요. 나중에 앱 설정에서 변경 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg musikkilden du vil bruke. Du kan endre dette senere i appinnstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz źródło muzyki, którego chcesz użyć. Możesz to później zmienić w ustawieniach aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите источник музыки, который хотите использовать. Вы можете изменить его позже в настройках приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பயன்படுத்த விரும்பும் இசை மூலத்தைத் தேர்ந்தெடுக்கவும். இதை நீங்கள் பின்னர் செயலி அமைப்புகளில் மாற்றலாம்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz müzik kaynağını seçin. Bunu daha sonra uygulama ayarlarından değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть власний звук, який буде відтворюватися після закінчення таймера. Підтримувані формати: MP3, M4A, WAV та AIFF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择您想要使用的音乐源。您可以稍后在应用设置中更改此项。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแหล่งเพลงที่คุณต้องการใช้ คุณสามารถเปลี่ยนได้ภายหลังในการตั้งค่าแอป"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de muziekbron die je wilt gebruiken. Je kunt dit later wijzigen in de app-instellingen."
          }
        }
      }
    },
