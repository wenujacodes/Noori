    "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill.": {
      "comment": "A description of how the color-coding feature works.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمزج التحولات السلسة بين الأخضر (0-60٪) والأصفر (60-85٪) والأحمر (85-100٪) من خلال التعبئة بأكملها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plynulé přechody mísí zelenou (0–60 %), žlutou (60–85 %) a červenou (85–100 %) barvu v celém výplni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glatte Übergänge mischen Grün (0–60%), Gelb (60–85%) und Rot (85–100%) durch die gesamte Füllung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transitions douces mélangent le vert (0 à 60 %), le jaune (60 à 85 %) et le rouge (85 à 100 %) tout au long du remplissage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરળ પરિવર્તનો સમગ્ર ભરાવટમાં લીલું (0–60%), પીળું (60–85%), અને લાલ (85–100%) સંયોજિત કરે છે."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transizioni fluide mescolano verde (0-60%), giallo (60-85%) e rosso (85-100%) attraverso l'intero riempimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jevne overganger blander grønn (0–60 %), gul (60–85 %) og rød (85–100 %) gjennom hele fyllingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавный переход от зеленого (0-60%) к желтому (60-85%) и красному (85-100%)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மென்மையான மாற்றங்கள், முழு நிரப்பிலும் பச்சை (0–60%), மஞ்சள் (60–85%), மற்றும் சிவப்பு (85–100%) ஆகியவற்றைக் கலக்கிறது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pürüzsüz geçişler Yeşil (%0–60), Sarı (%60–85) ve Kırmızıyı (%85–100) tüm dolgu boyunca harmanlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавний перехід між зеленим (0–60 %), жовтим (60–85 %) і червоним (85–100 %) кольорами по всій площі заповнення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑过渡在整个填充中混合绿色（0-60%）、黄色（60-85%）和红色（85-100%）。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloeiende overgangen laten groen (0–60%), geel (60–85%) en rood (85–100%) door de gehele vulling lopen."
          }
        }
      }
    },
    "Sneak Peek shows the media title and artist under the notch for a few seconds.": {
